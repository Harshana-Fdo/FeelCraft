# Local API and frontend origins
PORT=5000
HOST=localhost
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Optional public HTTPS origin. Leave empty for local sharing.
PUBLIC_APP_URL=

# MariaDB or MySQL connection. Fill in a dedicated local database account.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=feelcraft_db
DB_USER=
DB_PASSWORD=
DB_TLS=false

# Set true to develop without the database using browser-local drafts.
DB_DISABLED=false

# Set a unique random secret of at least 32 bytes for account access.
JWT_ACCESS_SECRET=
